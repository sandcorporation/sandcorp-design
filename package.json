{
  "name": "sandcorp-design",
  "version": "0.6.0",
  "description": "Sandcorp 공통 디자인: CSS 토큰과 클래스 컴포넌트",
  "license": "UNLICENSED",
  "type": "module",
  "repository": "github:sandcorporation/sandcorp-design",
  "files": [
    "assets",
    "dist",
    "src"
  ],
  "exports": {
    "./css": "./dist/sandcorp.css",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm build && pnpm icons && git diff --exit-code --stat dist assets && pnpm test && pnpm lint",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.6.0",
    "vitest": "^3.2.0"
  }
}
